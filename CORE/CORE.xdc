## TRS-80 Model I for MEGA65 (megatrs80)
##
## Core specific constraints
##
## This machine is based on TRS-80_MiSTer
## Powered by MiSTer2MEGA65
## MEGA65 port done in 2026 and licensed under GPL v3


## Name Autogenerated Clocks
## Important: Using them in subsequent statements, e.g. clock dividers requires that they
## have been named/defined here before
## otherwise Vivado does not find the pins)
create_generated_clock -name main_clk      [get_pins CORE/clk_gen/i_clk_main/CLKOUT0]   ;# 42.578 MHz

## fdc_clk_div (CPU speed factor 1/2/3/12) is quasi-static: it only changes with the speed setting,
## tape reads or a port 254 write. floppy.v and fdc1771.sv divide constants by it combinationally
## (~33 ns), so give those paths two main_clk cycles. A transient value in the drive timing counters
## for a cycle after a speed change is harmless.
set_multicycle_path -from [get_cells -hierarchical -filter {NAME =~ "*/trs80/fdc_clk_div_reg*"}] -setup 2
set_multicycle_path -from [get_cells -hierarchical -filter {NAME =~ "*/trs80/fdc_clk_div_reg*"}] -hold 1
